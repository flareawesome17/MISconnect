  "version": "1.0.8",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @misconnect/web",
    "dev:web": "npm run dev --workspace @misconnect/web",
    "start:web": "npm run start --workspace @misconnect/web",
    "build": "npm run build --workspace @misconnect/web",
