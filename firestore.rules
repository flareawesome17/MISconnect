rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnerByUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOwnerByEmail(email) {
      return signedIn() && request.auth.token.email == email;
    }

    // Public department reads remain available for signup and request forms.
    match /departments/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Roles, counters, password manager, and privileged writes now flow through the API.
    match /roles/{document=**} {
      allow read, write: if false;
    }

    match /counters/{document=**} {
      allow read, write: if false;
    }

    match /pswrdManager/{document=**} {
      allow read, write: if false;
    }

    // Users can only read their own profile document directly.
    match /users/{userId} {
      allow get: if isOwnerByUid(resource.data.uid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Customers can directly create and read only their own tickets.
    // Staff and privileged mutations must go through the API.
    match /tickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.submittedBy == request.auth.token.email;
      allow get: if isOwnerByEmail(resource.data.submittedBy);
      allow list: if false;
      allow update, delete: if false;
    }

    // Realtime notification reads are limited to the owning user.
    match /notifications/{notificationId} {
      allow get: if isOwnerByUid(resource.data.userId);
      allow list: if false;
      allow update: if isOwnerByUid(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.read is bool;
      allow create, delete: if false;
    }

    // Deny all other direct browser access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
